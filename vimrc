" Require vim 7.4 or higher

syntax on
colorscheme habamax

set number
set relativenumber
set nowrap
set colorcolumn=80

set laststatus=2
set statusline=%f\ %y
set showmode
set showcmd

set breakindent
set autoindent
set smartindent
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

set nobackup
set nowritebackup
